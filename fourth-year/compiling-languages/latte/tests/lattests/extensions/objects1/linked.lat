class Node {
  int elem;
  Node next;
  void setElem(int c) { elem = c; }
  void setNext(Node n) { next = n; }
  int getElem() { return elem; }
  Node getNext() { return next; }
}
class Stack {
  Node head;
  int len;
  void push(int c) {
    len++;
    Node newHead = new Node;
    newHead.setElem(c);
    newHead.setNext(head);
    head = newHead;
  }
  boolean isEmpty() {
    return len == 0;
  }

  int top() {
    return head.getElem();
  }

  void pop() {
    len--;
    head = head.getNext();
  }
}

int main() {
   Stack s = new Stack;
   int i= 0;
   while (i<10) {
     s.push(i);
     i++;
   }
     
   while (!s.isEmpty()) {
     printInt(s.top());
     s.pop();
   }
   return 0;
}
