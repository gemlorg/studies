class Node {
  int elem;
  Node next;

  void setElem (int e)  { elem = e; }
  void setNext (Node n) { next = n; }

  int  getElem () { return elem; }
  Node getNext () { return next; }

}

class IntQueue {
  Node front;
  Node rear;
  int size;

  boolean isEmpty () { return size == 0; }

  void insert (int x) {
    Node last = new Node;
    last.setElem(x);
    if (size == 0)
      front = last;
    else 
      rear.setNext(last);
    rear = last;
    size++;
  }

  int first () { return front.getElem(); }

  void rmFirst () {
    size--;
    front = front.getNext();
  }

  int size () {
    return size;
  }
}

int f (int x) {
  return x*x + 3;
}

int main () {
  IntQueue q = new IntQueue;
  q.insert(f(3));
  q.insert(5);
  printInt(q.first());
  printInt(q.size());
  q.rmFirst();

  printInt(q.first());
  return 0;
}

     