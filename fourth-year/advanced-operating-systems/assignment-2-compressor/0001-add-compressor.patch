diff --git a/kernel/bpf/bpf_compressor.c b/kernel/bpf/bpf_compressor.c
new file mode 100644
index 000000000..816dcdf54
--- /dev/null
+++ b/kernel/bpf/bpf_compressor.c
@@ -0,0 +1,242 @@
+#include <linux/bpf.h>
+#include <linux/types.h>
+#include <linux/bpf_compressor.h>
+#include <linux/syscalls.h>
+#include <linux/file.h>
+#include <linux/filter.h>
+#include <linux/lzo.h>
+
+//The bound is arbitrary. My assumption is that for the purpose of 
+//this assignment it will be sifficient.
+#define MAX_LZO_COMPRESS_INPUT_SIZE (10 * 1024 * 1024) // 10 MiB
+
+#define COMPRESSOR_HOOK(RET, DEFAULT, NAME, ...)	\
+noinline RET bpf_compressor_##NAME(__VA_ARGS__)	\
+{						\
+	return DEFAULT;				\
+}
+#include <linux/compressor_hook_defs.h>
+#undef COMPRESSOR_HOOK
+
+
+#define COMPRESSOR_HOOK(RET, DEFAULT, NAME, ...) BTF_ID(func, bpf_compressor_##NAME)
+BTF_SET_START(bpf_compressor_hooks)
+#include <linux/compressor_hook_defs.h>
+#undef COMPRESSOR_HOOK
+BTF_SET_END(bpf_compressor_hooks)
+
+
+static const struct bpf_func_proto *
+bpf_compressor_func_proto(enum bpf_func_id func_id, const struct bpf_prog *prog)
+{
+	switch(func_id) {
+        case BPF_FUNC_get_current_uid_gid:
+		return &bpf_get_current_uid_gid_proto;
+	case BPF_FUNC_get_current_pid_tgid:
+		return &bpf_get_current_pid_tgid_proto;
+	case BPF_FUNC_copy_from_buffer:
+		return &bpf_copy_from_buffer_proto;
+	case BPF_FUNC_lzo_compress:
+		return &bpf_lzo_compress_proto;
+	default:
+		return bpf_base_func_proto(func_id, prog);
+	}
+
+
+}
+static bool bpf_compressor_is_valid_access(int off, int size,
+					  enum bpf_access_type type,
+					  const struct bpf_prog *prog,
+					  struct bpf_insn_access_aux *info)
+{
+	if (type != BPF_READ)
+		return false;
+	if (off < 0 || size < 0|| off + size > sizeof(struct compress_ctx))
+		return false;
+
+
+	return true;
+}
+
+int bpf_compressor_verify_prog(struct bpf_verifier_log *vlog,
+			const struct bpf_prog *prog)
+{
+	u32 btf_id = prog->aux->attach_btf_id;
+	const char *func_name = prog->aux->attach_func_name;
+
+	if (!prog->gpl_compatible) {
+		bpf_log(vlog,
+			"COMPRESSOR programs must have a GPL compatible license\n");
+		return -EINVAL;
+	}
+
+
+	if (!btf_id_set_contains(&bpf_compressor_hooks, btf_id)) {
+		bpf_log(vlog, "attach_btf_id %u points to wrong type name %s\n",
+			btf_id, func_name);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+const struct bpf_prog_ops compressor_prog_ops = {
+};
+
+const struct bpf_verifier_ops compressor_verifier_ops = {
+
+	.get_func_proto = bpf_compressor_func_proto,
+	.is_valid_access = bpf_compressor_is_valid_access,
+};
+
+SYSCALL_DEFINE3(get_compression_stats, int, fd, size_t __user *, bytes_written, size_t __user *, bytes_after_compression)
+{
+	struct file *f;
+	int retval = 0;
+	int err = 0;
+	size_t bwritten, bcompressed;
+
+	f = fd_file(fdget(fd));
+	if (!f)
+		return -EBADF;
+	spin_lock(&f->f_lock);
+	if (!f->f_do_compress) {
+		retval = -EINVAL;
+		goto cleanup;
+	}
+	bwritten = f->f_bwritten;
+	bcompressed = f->f_bcompressed;
+
+cleanup:
+	spin_unlock(&f->f_lock);
+	if(retval >= 0) {
+		err = copy_to_user(bytes_written, &bwritten, sizeof(size_t));
+		if(err)
+			return err;
+		err = copy_to_user(bytes_after_compression, &bcompressed, sizeof(size_t));
+		if(err)
+			return err;
+	}
+	return retval;
+}
+
+SYSCALL_DEFINE1(reset_compression_stats, int, fd)
+{
+	struct file *f;
+	int retval = 0;
+
+	f = fd_file(fdget(fd));
+	if (!f)
+		return -EBADF;
+	spin_lock(&f->f_lock);
+	if (!f->f_do_compress) {
+		retval = -EINVAL;
+		goto cleanup;
+	}
+	f->f_bwritten = 0;
+	f->f_bcompressed = 0;
+
+cleanup:
+	spin_unlock(&f->f_lock);
+	return retval;
+}
+
+static bool compressor_helper_proto_allowed(const struct bpf_prog *prog)
+{
+	return prog->type == BPF_PROG_TYPE_COMPRESSOR &&
+	       prog->expected_attach_type == BPF_COMPRESSOR;
+}
+
+BPF_CALL_4(bpf_copy_from_buffer,struct compress_ctx *, _ctx, unsigned long, offset, void *, ptr, unsigned long, size)
+{
+	size_t len;
+	int err;
+
+	struct compress_ctx_kern *ctx =
+		container_of(_ctx, struct compress_ctx_kern, ctx);
+	if (offset > ctx->ctx.size)
+	       return -EINVAL;
+	len = min(ctx->ctx.size - offset, size);
+	err =  copy_from_user(ptr, ctx->buf + offset, len);
+	return err < 0 ? err : 0;
+}
+
+const struct bpf_func_proto bpf_copy_from_buffer_proto = {
+    .func = bpf_copy_from_buffer,
+    .gpl_only = false,
+    .ret_type = RET_INTEGER,
+    .arg1_type = ARG_PTR_TO_CTX,
+    .arg2_type = ARG_ANYTHING,
+    .arg3_type = ARG_PTR_TO_MEM,
+    .arg4_type = ARG_CONST_SIZE,
+    .allowed = compressor_helper_proto_allowed,
+};
+
+//I believe not the assignment nor the tests actually specify what
+//needs to be done with the compressed data. 
+//Since the "copy from buffer" function makes no sense if the 
+//compressed data is not put back in, I am assuming that the compressed 
+//data needs to be put into the original buffer.
+BPF_CALL_1(bpf_lzo_compress, void *, _ctx)
+{
+	struct compress_ctx_kern *ctx;
+	char *out_kbuf = NULL;
+	void *workspace = NULL;
+	char *in_kbuf = NULL;
+	size_t in_len;
+	unsigned long out_len_ul;
+	int ret = 0;
+
+	ctx = container_of(_ctx, struct compress_ctx_kern, ctx);
+	if (!ctx) {
+		ret = -EINVAL;
+		goto cleanup;
+	}
+	in_kbuf = ctx->buf;
+	in_len = ctx->ctx.size;
+	if (!in_kbuf) {
+		ret = -EINVAL;
+		goto cleanup;
+	}
+	if(!in_len) {
+		ret = 0; 
+		goto cleanup;
+	}
+
+	if (in_len > MAX_LZO_COMPRESS_INPUT_SIZE)
+		return -EFBIG;
+	workspace = kvmalloc(LZO1X_MEM_COMPRESS, GFP_KERNEL);
+	if (!workspace) {
+		ret = -ENOMEM;
+		goto cleanup;
+	}
+	out_len_ul = lzo1x_worst_compress(in_len);
+	out_kbuf = kvmalloc(out_len_ul, GFP_KERNEL);
+	if (!out_kbuf) {
+		ret = -ENOMEM;
+		goto cleanup;
+	}
+	
+	if (lzo1x_1_compress(ctx->buf, in_len, 
+		out_kbuf, &out_len_ul,
+		 workspace) != LZO_E_OK) {
+		ret = -EINVAL; 
+		goto cleanup;
+	}
+
+	ctx->buf = out_kbuf;
+	ctx->ctx.size = out_len_ul;
+	ret = (int)out_len_ul;
+
+cleanup:
+	kvfree(workspace);
+	kvfree(in_kbuf);
+	return ret;
+}
+
+const struct bpf_func_proto bpf_lzo_compress_proto = {
+    .func = bpf_lzo_compress,
+    .gpl_only = false,
+    .ret_type = RET_INTEGER,
+    .arg1_type = ARG_PTR_TO_CTX,
+    .allowed = compressor_helper_proto_allowed,
+};
