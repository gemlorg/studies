+#ifndef _BPF_COMPRESSOR_H
+#define _BPF_COMPRESSOR_H
+
+#include <linux/types.h>
+#include <linux/sched.h>
+#include <linux/uidgid.h>
+#include <linux/bpf.h>
+#include <linux/bpf_verifier.h>
+
+struct compress_ctx {
+    union {
+        struct {
+            loff_t offset;
+            size_t size;
+        };
+        struct {
+            kuid_t uid;
+            kgid_t gid;
+        };
+    };
+};
+struct compress_ctx_kern {
+        void *buf;
+        struct compress_ctx ctx;
+};
+
+#define COMPRESSOR_HOOK(RET, DEFAULT, NAME, ...) \
+    RET bpf_compressor_##NAME(__VA_ARGS__);
+#include <linux/compressor_hook_defs.h>
+#undef COMPRESSOR_HOOK
+
+int bpf_compressor_verify_prog(struct bpf_verifier_log *vlog,
+			const struct bpf_prog *prog);
+
+#endif /* _BPF_COMPRESSOR_H */
