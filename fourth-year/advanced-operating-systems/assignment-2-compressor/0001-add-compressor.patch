 	putname(tmp);
diff --git a/fs/read_write.c b/fs/read_write.c
index befec0b5c..d55cf7c88 100644
--- a/fs/read_write.c
+++ b/fs/read_write.c
@@ -20,6 +20,7 @@
 #include <linux/compat.h>
 #include <linux/mount.h>
