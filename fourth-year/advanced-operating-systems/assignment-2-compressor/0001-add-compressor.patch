 #include "internal.h"
 
 #include <linux/uaccess.h>
@@ -660,6 +661,49 @@ ssize_t kernel_write(struct file *file, const void *buf, size_t count,
 }
 EXPORT_SYMBOL(kernel_write);
 
+#ifdef CONFIG_BPF_SYSCALL
+inline ssize_t do_compressor_verify_write(struct file *file, const char __user *buf, size_t count, loff_t *pos, ssize_t bytes_written) 
+{
+	struct compress_ctx_kern ctx;
+	ssize_t ret = 0;
+	void *kbuf;
+
+	if (bytes_written < 0)
+		return bytes_written;
+
+	kbuf = kvmalloc(count, GFP_KERNEL);
+	if (!kbuf) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (unlikely(copy_from_user(kbuf, buf, count))) {
+		ret = -EINVAL;
+		goto cleanup;
+	}
+
+	ctx.buf = kbuf;
+	ctx.ctx.offset = *pos - bytes_written;
+	ctx.ctx.size = count;
+	ret = bpf_compressor_verify(&(ctx.ctx));
+	if (ret < 0) {
+		ret = -EINVAL;
+		goto cleanup;
+	}
+cleanup:
+	kvfree(ctx.buf);
+out:
+	spin_lock(&file->f_lock);
+	if (bytes_written > 0) 
+		file->f_bwritten += bytes_written;
+	if (ret > 0) 
+		file->f_bcompressed += ret;
+	spin_unlock(&file->f_lock);
+
+	return ret < 0 ? ret : bytes_written;
+}
+#endif
+
 ssize_t vfs_write(struct file *file, const char __user *buf, size_t count, loff_t *pos)
 {
 	ssize_t ret;
@@ -688,6 +732,11 @@ ssize_t vfs_write(struct file *file, const char __user *buf, size_t count, loff_
 		add_wchar(current, ret);
 	}
 	inc_syscw(current);
+
+#ifdef CONFIG_BPF_SYSCALL
+	if (file->f_do_compress)
+		ret = do_compressor_verify_write(file, buf, count, pos, ret);
+#endif
 	file_end_write(file);
 	return ret;
 }
@@ -1032,12 +1081,49 @@ static ssize_t vfs_readv(struct file *file, const struct iovec __user *vec,
 	return ret;
 }
 
+
+
+#ifdef CONFIG_BPF_SYSCALL
+static ssize_t do_loop_compressor_verify_writev(struct file *file, struct iov_iter *iter,
+		loff_t *ppos, ssize_t bytes_written)
+{
+	ssize_t ret = 0;
+	ssize_t nr = 0;
+	const char __user *buf;
+	ssize_t count;
+	ssize_t curr_bytes_written;
+	loff_t curr_pos = *ppos - bytes_written;
+	
+	if (bytes_written < 0)
+		return bytes_written;
+
+	while (iov_iter_count(iter)) {
+		buf = iter_iov_addr(iter);
+		count = iter_iov_len(iter);
+		curr_bytes_written = min(bytes_written, count);
+		bytes_written -= curr_bytes_written;
+		curr_pos += curr_bytes_written;
+		nr = do_compressor_verify_write(file, buf, count, &curr_pos, curr_bytes_written);
+		ret += nr;
+		if (nr != iter_iov_len(iter))
+			break;
+		iov_iter_advance(iter, nr);
+	}
+	if (nr < 0)
+		return nr;
+	return ret;
+}
+#endif
+
 static ssize_t vfs_writev(struct file *file, const struct iovec __user *vec,
 			  unsigned long vlen, loff_t *pos, rwf_t flags)
 {
 	struct iovec iovstack[UIO_FASTIOV];
 	struct iovec *iov = iovstack;
 	struct iov_iter iter;
+#ifdef CONFIG_BPF_SYSCALL
+	struct iov_iter bpf_iter;
+#endif
 	size_t tot_len;
 	ssize_t ret = 0;
 
@@ -1054,6 +1140,10 @@ static ssize_t vfs_writev(struct file *file, const struct iovec __user *vec,
 	tot_len = iov_iter_count(&iter);
 	if (!tot_len)
 		goto out;
+	
+#ifdef CONFIG_BPF_SYSCALL
+	bpf_iter = iter;
+#endif
 
 	ret = rw_verify_area(WRITE, file, pos, tot_len);
 	if (ret < 0)
@@ -1064,6 +1154,10 @@ static ssize_t vfs_writev(struct file *file, const struct iovec __user *vec,
 		ret = do_iter_readv_writev(file, &iter, pos, WRITE, flags);
 	else
 		ret = do_loop_readv_writev(file, &iter, pos, WRITE, flags);
+#ifdef CONFIG_BPF_SYSCALL
+	if (file->f_do_compress)
+		ret = do_loop_compressor_verify_writev(file, &bpf_iter, pos, ret);
+#endif
 	if (ret > 0)
 		fsnotify_modify(file);
 	file_end_write(file);
