 EXPORT_SYMBOL(file_open_root);
 
+#ifdef CONFIG_BPF_SYSCALL
+static void do_compressor_decide(struct file *f)
+{
+	struct compress_ctx_kern ctx;
+	int decision;
+
+	ctx.buf = NULL;
+	ctx.ctx.uid = current_uid();
+	ctx.ctx.gid = current_gid();
+
+	decision = bpf_compressor_decide(&ctx.ctx);
+	spin_lock(&f->f_lock);
+	f->f_do_compress = decision > 0;
+	spin_unlock(&f->f_lock);
+}
+#endif
